{
  "manifest_version": 3,
  "name": "Flax — XRP Wallet",
  "short_name": "Flax",
  "version": "1.0.0",
  "description": "A modern XRP wallet with native yield, powered by Flare Confidential Compute.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flax",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://faucet.altnet.rippletest.net/*",
    "https://s.altnet.rippletest.net/*",
    "https://coston2-api.flare.network/*"
  ]
}
